---
import { txt, rich, rows, f } from "../bcms-bind";
import RectReveal from "../components/RectReveal.astro";

interface Props {
  items: { title: string; text: string }[];
}

const { items } = Astro.props;
const G = "for-group-for-modern-teams";
const list = rows(
  G,
  items.map((i) => ({ "h2-for-modern-teams": i.title, "p-every-feature-is-designed": i.text })),
);
---

<div class="sy-statements">
  <RectReveal ignoreLast>
    {
      list.map((_row, i) => (
        <div class="box">
          <div class="u-container">
            <div class="content">
              <h2
                class="u-heading"
                data-sy-reveal={i === 0 ? "words" : undefined}
                {...f(`${G}[${i}].h2-for-modern-teams`)}
              >
                {txt(`${G}[${i}].h2-for-modern-teams`, items[i]?.title ?? "")}
              </h2>
              <p
                class="u-text"
                data-sy-reveal={i === 0 ? "lines" : undefined}
                {...f(`${G}[${i}].p-every-feature-is-designed`, "richtext")}
                set:html={rich(`${G}[${i}].p-every-feature-is-designed`, items[i]?.text ?? "")}
              />
            </div>
          </div>
        </div>
      ))
    }
  </RectReveal>
  <div data-gl-place="0"></div>
</div>

<style>
  [data-gl-place] {
    --d: 1;
    --s: 17rem;
    position: absolute;
    right: 0;
    left: 0;
    margin: 0 auto;
    bottom: 0;

    @media (--mq-tablet) {
      bottom: 50%;
    }
  }

  .sy-statements {
    margin-bottom: 0;
    position: relative;
    z-index: 9;
  }

  .box {
    width: 100%;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg);
    color: var(--color-text);
    text-align: center;
    flex-direction: column;

    &:nth-child(2) {
      background: var(--color-brand-1);
      color: var(--color-brand-3);
    }

    &:nth-child(3) {
      background: var(--color-brand-3);
    }
  }

  .content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  h2 {
    --fs: 3rem;
    --lh: 1.3;
  }

  p {
    max-width: 40em;
  }
</style>
